# Comma-separated list of allowed origins (production and local)
CORS_ORIGIN=https://app-sofia-reservas.vercel.app,http://localhost:5173
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
DATABASE_URL=postgresql://<db-user>:<db-password>@<pooler-host>:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://<db-user>:<db-password>@<direct-host>:5432/postgres
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/auth/reset-password
INVITATION_REDIRECT_URL=http://localhost:5173/auth/accept-invitation