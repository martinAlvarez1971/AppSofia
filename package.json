{
  "name": "sofia-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --prefix backend run start:dev",
    "typecheck": "tsc -b --pretty false",
